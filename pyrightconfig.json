{
  "include": [
    "./src",
    "./pkgs",
    "./stubs"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/scripts"
  ],
  "ignore": [
    "**/__pycache__",
    "**/.venv",
    "**/scripts"
  ],
  "extraPaths": [
    "./src",
    "./pkgs",
    "./stubs"
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "All",
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "reportGeneralTypeIssues": "warning"
}