# ============================================================================
# MANIFEST.in - Source Distribution File Inclusion
# ============================================================================
# This file specifies which files to include in source distributions (.tar.gz)
# Wheel distributions (.whl) use pyproject.toml's package-data instead

# ============================================================================
# Documentation and Metadata
# ============================================================================
include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
include setup.py

# py.typed marker for PEP 561 compliance
recursive-include src py.typed

# ============================================================================
# Build Scripts (for users building from source)
# ============================================================================
include scripts/build-rocksdb-linux.sh
include scripts/build-rocksdb-macos.sh
include scripts/build-rocksdb-windows.ps1

# ============================================================================
# esrocks Package Files
# ============================================================================
# Cython source files (.pyx, .pxd)
recursive-include src/esrocks *.pyx
recursive-include src/esrocks *.pxd

# C++ wrapper headers
recursive-include src/esrocks/include *.hpp
recursive-include src/esrocks/include *.h

# Python type stubs
recursive-include src/esrocks *.pyi

# Python files
recursive-include src/esrocks *.py

# ============================================================================
# estup Package Files
# ============================================================================
# Cython source files (.pyx, .pxd)
recursive-include src/estup *.pyx
recursive-include src/estup *.pxd

# C++ wrapper headers
recursive-include src/estup/include *.hpp
recursive-include src/estup/include *.h

# Python type stubs
recursive-include src/estup *.pyi

# Python files
recursive-include src/estup *.py

# ============================================================================
# Pure Python
# ============================================================================
# These are automatically included by setuptools, but we can be explicit
recursive-include src/everyshape *.py

# ============================================================================
# Tests (optional - include if you want tests in sdist)
# ============================================================================
recursive-include tests *.py
include tests/README.md

# ============================================================================
# Exclusions
# ============================================================================
# Exclude compiled files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__

# Exclude Cython-generated C/C++ files (they'll be regenerated)
global-exclude *.c
global-exclude *.cpp
exclude src/esrocks/*.c
exclude src/esrocks/*.cpp

# Exclude build artifacts (TODO: double check)
global-exclude *.so
global-exclude *.dylib
global-exclude *.dll
prune build
prune dist
prune *.egg-info

# Exclude IDE and editor files
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo
global-exclude *~
prune .vscode
prune .idea

# Exclude version control
prune .git
global-exclude .gitignore
global-exclude .gitattributes

# Exclude CI/CD that users don't need
prune .github
exclude .pre-commit-config.yaml

# Exclude development files
exclude .coveragerc
exclude .ruff_cache
prune htmlcov
